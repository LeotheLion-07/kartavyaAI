# ==========================================
# Kartavya AI - Environment Configuration
# ==========================================

# Frontend Configuration (Vercel / Local)
# When deploying frontend on Vercel:
# - If using Vercel Services or single project rewrites, NEXT_PUBLIC_API_URL can be omitted or set to "/api/v1"
# - If backend is hosted separately (e.g. Render, Railway, Fly.io), set NEXT_PUBLIC_API_URL to that backend URL:
# NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api/v1
# BACKEND_URL=https://your-backend-api.onrender.com

# Backend Configuration
SECRET_KEY=kartavya-super-secure-jwt-secret-key-production-grade-2026
# DATABASE_URL=sqlite:///./kartavya.db
# DATABASE_URL=postgresql://user:password@host:5432/kartavya_db

# LLM Providers (Optional for cloud LLM inference)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gemini-1.5-pro

# Redis / Celery (Optional for async queue workers)
# REDIS_URL=redis://localhost:6379/0
